# @budget/api — copy to .env and fill in
# Schema of record: src/env.ts

# --- Auth (better-auth) ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public base URL the API is reachable at
BETTER_AUTH_URL=http://localhost:4000

# --- Database ---
# Matches the credentials created by docker/postgres/init.sql
DATABASE_URL=postgresql://budget:budget@localhost:5432/budget

# --- Server ---
# Optional, defaults to 4000
PORT=4000
# Optional, defaults to http://localhost:3000
CLIENT_ORIGIN=http://localhost:3000

# --- Object storage (S3-compatible, used by the files router) ---
BUCKET_REGION=
BUCKET_ACCESS_KEY_ID=
BUCKET_SECRET_KEY=
BUCKET_NAME=
# Public base URL objects are served from, no trailing slash
BUCKET_URL=

# --- Email / SMTP (email OTP delivery) ---
# Defaults target the mailpit container from docker/docker-compose.yml.
# Leave these unset for local dev; inbox UI is at http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
# CAUTION: parsed with z.coerce.boolean(), so ANY non-empty value is true —
# including the literal "false". To disable TLS, leave this unset or empty.
SMTP_SECURE=
# Optional; auth is only sent when BOTH user and password are set
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Budget <noreply@budget.local>

# --- Push notifications (Expo) ---
# Optional. Only needed for sending to the Expo push service with an
# access token; unset works for unauthenticated sends.
EXPO_ACCESS_TOKEN=

# --- Plaid (bank sync) ---
# From the Plaid dashboard: https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox | production. Defaults to sandbox.
PLAID_ENV=sandbox
# Public HTTPS URL Plaid POSTs webhooks to, e.g. https://api.example.com/webhooks/plaid
# Leave UNSET locally — Plaid cannot reach localhost.
PLAID_WEBHOOK_URL=

# --- Encryption (Plaid access tokens at rest) ---
# Exactly 64 hex chars (32 bytes). Generate with: openssl rand -hex 32
# Rotating this makes every stored access token undecryptable — users must reconnect.
ENCRYPTION_KEY=
